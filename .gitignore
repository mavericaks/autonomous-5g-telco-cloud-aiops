# OS / Editor files
.DS_Store
*.swp
*~


# Explicitly track the compact Golden State Cloud Recovery Bundle in GitHub Cloud
!golden_state_cloud_bundle/*.tar.gz
!golden_state_cloud_bundle/*.gz
!golden_state_cloud_bundle/*.npz
!golden_state_cloud_bundle/**
