# Python bytecode & caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.venv/
venv/

# Large live data warehouse & vault symlinks (stored on /data and /data_16tb)
cross_layer_dataset
golden_state_vault
*.db
*.db-wal
*.db-shm
*.jsonl.gz
*.tar
*.tar.gz

