[Unit]
Description=5G Multi-Tier Telemetry and Dataset Collection Daemon
After=network.target

[Service]
Type=simple
User=hpe
WorkingDirectory=/home/hpe/telemetry
ExecStart=/usr/bin/python3 /home/hpe/telemetry/telemetry_daemon.py
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
